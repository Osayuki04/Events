{# The layout every page uses. Pages fill in the "title" and "content" blocks.
   Variables: page (which tab is active), flash (message after saving), token (form token). #}
<!doctype html>
<html lang="en-GB">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{% block title %}{% endblock %} · Yukylo</title>

    <!-- Tailwind CSS (the only styling on the site), built from assets/css/input.css with "npm run build:css".
         It is a normal CSS file, so the Content-Security-Policy can block all inline styles and scripts. -->
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="icon" href="assets/img/favicon.svg" type="image/svg+xml">
</head>
<body class="bg-white font-sans text-zinc-900 antialiased">

{# ---- Top navigation ---- #}
{% set tabs = {index: 'Dashboard', events: 'Events', people: 'People', jobs: 'Jobs'} %}
<header class="sticky top-0 z-30 border-b border-zinc-200 bg-white">
    <div class="mx-auto flex max-w-[1600px] flex-wrap items-end gap-x-6 px-4 lg:px-6">
        <a class="my-3 flex items-center gap-2.5 text-lg font-semibold" href="index.php">
            <span class="grid size-9 place-items-center rounded-xl bg-brand text-white"><i class="bi bi-journal-bookmark-fill"></i></span>Yukylo
        </a>

        {# Logged out (login / create account pages): only the name, no menu #}
        {% if user %}
        <button class="my-3 ml-auto text-2xl lg:hidden" type="button" data-menu-toggle aria-controls="main-nav" aria-expanded="false" aria-label="Menu">
            <i class="bi bi-list"></i>
        </button>

        <div class="hidden w-full flex-col gap-3 pb-3 lg:flex lg:w-auto lg:flex-1 lg:flex-row lg:items-end lg:pb-0" id="main-nav">
            <nav class="flex flex-col lg:mx-auto lg:flex-row">
                {% for key, label in tabs %}
                    {% if key == page %}
                        <a class="border-brand px-1 py-3 font-semibold text-brand lg:-mb-px lg:border-b-2 lg:px-5" href="{{ key }}.php" aria-current="page">{{ label }}</a>
                    {% else %}
                        <a class="border-transparent px-1 py-3 font-medium text-zinc-500 hover:text-zinc-900 lg:-mb-px lg:border-b-2 lg:px-5" href="{{ key }}.php">{{ label }}</a>
                    {% endif %}
                {% endfor %}
            </nav>
            {% if page != 'index' %}
                <a class="self-start rounded-full bg-brand px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-brand-dark lg:mb-3 lg:self-auto" href="event_form.php">+ Add event</a>
            {% endif %}

            {# Who is logged in + log out (a POST form with the token, so other sites can't log you out) #}
            <form method="post" action="logout.php" class="m-0 flex items-center gap-3 lg:mb-3" data-ajax>
                <input type="hidden" name="token" value="{{ token }}">
                <span class="flex items-center gap-1.5 text-sm text-zinc-500"><i class="bi bi-person-circle"></i>{{ user }}</span>
                <button class="rounded-full border border-zinc-200 px-3.5 py-1.5 text-sm font-medium text-zinc-600 hover:border-brand hover:text-brand" type="submit">Log out</button>
            </form>
        </div>
        {% endif %}
    </div>
</header>

<main class="mx-auto max-w-[1600px] px-4 pb-14 pt-8 lg:px-8">

    {# ---- Message after saving ("Event saved."). app.js also puts Ajax messages here. ---- #}
    <div data-flash-area>
        {% if flash %}
            <div class="mb-6 flex items-center gap-3 rounded-xl border border-zinc-200 px-4 py-3" role="status" data-message>
                <i class="bi bi-check-square-fill text-brand"></i>
                <span class="flex-1">{{ flash }}</span>
                <button type="button" class="text-zinc-400 hover:text-zinc-900" data-dismiss aria-label="Close"><i class="bi bi-x-lg"></i></button>
            </div>
        {% endif %}
    </div>

    {% block content %}{% endblock %}
</main>

<script src="{{ asset('js/app.js') }}"></script>
</body>
</html>
