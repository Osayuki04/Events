{# The job cards on jobs.php. Every job is here; the ones that don't match the search are hidden.
   The live search (app.js) gets only the ids of the matching jobs and shows, hides and orders these cards.
   Every status label is drawn (only the job's own is shown), app.js shows the right one after the dropdown changes.
   Variables: jobs, visible (id => position of the jobs that match), statuses, status, q #}
{% import 'macros.twig' as ui %}

<div class="grid gap-4 md:grid-cols-2 2xl:grid-cols-3" data-cards>
        {% for job in jobs %}
            <article class="flex flex-col rounded-2xl border border-zinc-200 p-5" data-id="{{ job.id }}" {{ visible[job.id] is defined ? '' : 'hidden' }}>
                <div class="flex items-start justify-between gap-3">
                    <h2 class="mb-1 text-xl font-semibold">{{ job.title }}</h2>
                    <span class="mt-1">
                        {% for s in statuses %}
                            <span data-status-label {{ s == job.status ? '' : 'hidden' }}>{{ ui.status(s) }}</span>
                        {% endfor %}
                    </span>
                </div>
                <p class="text-[13px] text-zinc-500">{{ [job.company, job.location]|filter(v => v)|join(' · ') }}</p>

                {% if job.notes %}
                    <p class="mt-2.5 text-[13px] text-zinc-500">{{ job.notes }}</p>
                {% endif %}

                <div class="mt-auto py-4">
                    <div class="text-[11px] text-zinc-500">Found at</div>
                    <a class="block truncate font-medium text-brand hover:underline" href="event.php?id={{ job.event_id }}">{{ job.event_title }}</a>
                    <div class="text-[13px] text-zinc-500">{{ job.event_date|date('j M Y') }}</div>
                </div>

                <div class="flex items-center gap-2 border-t border-zinc-200 pt-3">
                    {# Changing the dropdown saves straight away, in the background (Ajax, see app.js) #}
                    <form method="post" action="jobs.php" class="m-0 mr-auto flex items-center gap-2" data-ajax>
                        <input type="hidden" name="token" value="{{ token }}">
                        <input type="hidden" name="id" value="{{ job.id }}">
                        <input type="hidden" name="filter" value="{{ status }}">
                        <input type="hidden" name="q" value="{{ q }}">
                        <select class="rounded-xl border border-zinc-200 bg-white px-2.5 py-1.5 text-[13px] focus:border-brand focus:outline-none" name="status" data-autosubmit aria-label="Change status of {{ job.title }}">
                            {% for s in statuses %}
                                <option {{ job.status == s ? 'selected' }}>{{ s }}</option>
                            {% endfor %}
                        </select>
                        <button class="rounded-xl border border-zinc-200 px-3 py-1.5 text-[13px] font-medium" type="submit" data-autosubmit-button>Save</button>
                    </form>
                    {# The two calls to action: solid red first, red outline second #}
                    {% if job.url %}
                        <a class="rounded-xl bg-brand px-3.5 py-2 text-[13px] font-medium text-white transition-colors hover:bg-brand-dark" href="{{ job.url }}" target="_blank" rel="noopener">View advert</a>
                    {% endif %}
                    <a class="rounded-xl border border-brand px-3.5 py-2 text-[13px] font-medium text-brand transition-colors hover:bg-brand hover:text-white" href="job_form.php?id={{ job.id }}">Edit</a>
                </div>
            </article>
        {% endfor %}
</div>

<div class="rounded-2xl border border-zinc-200 px-4 py-14 text-center text-zinc-500" data-empty {{ visible ? 'hidden' }}>
        <p class="font-semibold text-zinc-900">{{ jobs ? 'No jobs match that search' : 'No jobs saved yet' }}</p>
        <p class="text-[13px]">Open an event and use the + next to “Jobs saved” to keep track of roles you hear about.</p>
</div>
