{# The event cards on events.php. Every event is here; the ones that don't match the search are hidden.
   The live search (search_box macro) gets only the ids of the matching events and shows, hides and orders these cards.
   Variables: events, visible (id => position of the events that match) #}
{% import 'macros.twig' as ui %}

<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4" data-cards>
        {% for event in events %}
            {# Same layout as the "Latest event" card: big red date block in the middle, buttons side by side at the bottom #}
            <article class="flex flex-col rounded-2xl border border-zinc-200 p-5" data-id="{{ event.id }}" {{ visible[event.id] is defined ? '' : 'hidden' }}>
                <div class="flex items-center justify-between gap-2">
                    <span class="rounded-full bg-zinc-100 px-2.5 py-0.5 text-[11px] font-medium">{{ event.category }}</span>
                    {% if event.rating %}
                        {{ ui.stars(event.rating) }}
                    {% else %}
                        <span class="text-[13px] text-zinc-500">Not rated</span>
                    {% endif %}
                </div>

                <div class="flex flex-1 flex-col items-center pt-2 text-center">
                    <div class="mb-4">{{ ui.date_block(event.event_date, true) }}</div>
                    <h3 class="text-xl font-semibold"><a class="hover:text-brand" href="event.php?id={{ event.id }}">{{ event.title }}</a></h3>
                    <p class="text-[13px] text-zinc-500">{{ [event.venue, event.city]|filter(v => v)|join(', ')|default('No venue added') }} · {{ event.event_date|date('Y') }}</p>
                    {% if event.seat %}
                        <span class="mt-3 rounded-full border border-brand px-2.5 py-1 text-[13px] font-medium text-brand">Seat: {{ event.seat }}</span>
                    {% endif %}
                    <p class="mt-3 line-clamp-2 text-[13px] text-zinc-500">{{ event.summary }}</p>
                    <p class="mt-2 text-[13px] font-medium">
                        {{ event.people_count }} {{ event.people_count == 1 ? 'person' : 'people' }} · {{ event.job_count }} {{ event.job_count == 1 ? 'job' : 'jobs' }}
                    </p>
                </div>

                {# The two calls to action (solid red first, red outline second), then a small bin button #}
                <div class="mt-5 grid grid-cols-[1fr_1fr_auto] gap-2">
                    <a class="rounded-xl bg-brand px-3 py-2.5 text-center text-sm font-medium text-white transition-colors hover:bg-brand-dark" href="event.php?id={{ event.id }}">View</a>
                    <a class="rounded-xl border border-brand px-3 py-2.5 text-center text-sm font-medium text-brand transition-colors hover:bg-brand hover:text-white" href="event_form.php?id={{ event.id }}">Edit</a>
                    {{ ui.delete_button('event_delete.php', {id: event.id}, 'Delete “' ~ event.title ~ '”?',
                        'The ' ~ event.people_count ~ (event.people_count == 1 ? ' person' : ' people') ~ ' and '
                        ~ event.job_count ~ (event.job_count == 1 ? ' job' : ' jobs') ~ ' saved from it will be deleted too.') }}
                </div>
            </article>
        {% endfor %}
</div>

<div class="rounded-2xl border border-zinc-200 px-4 py-14 text-center text-zinc-500" data-empty {{ visible ? 'hidden' }}>
        <p class="font-semibold text-zinc-900">{{ events ? 'No events match those filters' : 'No events yet' }}</p>
        <p class="text-[13px]">Try a wider date range, a lower rating, or clear the filters to see everything.</p>
</div>
