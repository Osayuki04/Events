{# The person cards on people.php. Everyone is here; the people that don't match the search are hidden.
   The live search (search_box macro) gets only the ids of the matching people and shows, hides and orders these cards.
   Variables: people, visible (id => position of the people that match) #}
{% import 'macros.twig' as ui %}

<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4" data-cards>
        {% for person in people %}
            {# Same layout as the "Latest event" card: big avatar in the middle, buttons side by side at the bottom #}
            <article class="flex flex-col rounded-2xl border border-zinc-200 p-5" data-id="{{ person.id }}" {{ visible[person.id] is defined ? '' : 'hidden' }}>
                <div class="flex items-center justify-between gap-2">
                    <span class="text-[13px] text-zinc-500">{{ person.event_date|date('j M Y') }}</span>
                    {{ ui.follow_badge(person.follow_up) }}
                </div>

                <div class="flex flex-1 flex-col items-center pt-2 text-center">
                    <div class="mb-4">{{ ui.avatar(person.id, 26) }}</div>
                    <h3 class="text-xl font-semibold">{{ person.name }}</h3>
                    <p class="text-[13px] text-zinc-500">{{ [person.job_title, person.company]|filter(v => v)|join(' · ') }}</p>
                    <p class="mt-1 text-[13px] text-zinc-500">
                        Met at <a class="text-brand hover:underline" href="event.php?id={{ person.event_id }}">{{ person.event_title }}</a>
                    </p>

                    <div class="mt-4">{{ ui.contact_links(person, true) }}</div>

                    {% if person.notes %}
                        <p class="mt-3 text-[13px] text-zinc-500">{{ person.notes }}</p>
                    {% endif %}
                </div>

                {# View (their own page, person.php), Edit, and the bin button #}
                <div class="mt-5 grid grid-cols-[1fr_1fr_auto] gap-2">
                    <a class="rounded-xl bg-brand px-3 py-2.5 text-center text-sm font-medium text-white transition-colors hover:bg-brand-dark" href="person.php?id={{ person.id }}">View</a>
                    <a class="rounded-xl border border-brand px-3 py-2.5 text-center text-sm font-medium text-brand transition-colors hover:bg-brand hover:text-white" href="person_form.php?id={{ person.id }}">Edit</a>
                    {{ ui.delete_button('person_form.php?id=' ~ person.id, {action: 'delete'}, 'Remove ' ~ person.name ~ '?',
                        person.name ~ ' and their contact details will be deleted from your diary.') }}
                </div>
            </article>
        {% endfor %}
</div>

<div class="rounded-2xl border border-zinc-200 px-4 py-14 text-center text-zinc-500" data-empty {{ visible ? 'hidden' }}>
        <p class="font-semibold text-zinc-900">{{ people ? 'Nobody matches that search' : 'No people yet' }}</p>
        <p class="text-[13px]">Open an event and use the + next to “People you met” to save someone.</p>
</div>
