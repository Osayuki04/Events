# Yukylo - Apache settings
Options -Indexes
DirectoryIndex index.php

# Hide repository and tooling files
<FilesMatch "^(\.git.*|README\.md|commit-plan\.md|composer\.(json|lock))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Folders that are only used by PHP, phpMyAdmin or the command line, never opened in a browser
<IfModule mod_alias.c>
    RedirectMatch 403 /(sql|vendor|templates|tests)/
</IfModule>

# The security headers for pages are sent by PHP (top of db.php). These cover the static files.
<IfModule mod_headers.c>
    Header unset X-Powered-By
    <FilesMatch "\.(css|js|woff2?|svg)$">
        Header set X-Content-Type-Options "nosniff"
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>
